# =============================================================
# VOT.AR BLOCKCHAIN — Variables de entorno
# Copiar como .env.local y completar con valores reales.
# NUNCA commitear el archivo con valores reales.
# =============================================================

# --- Base de datos (PostgreSQL) ---
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/votar_blockchain?schema=public

# --- NextAuth.js ---
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET=reemplazar-con-secreto-aleatorio-de-32-bytes
NEXTAUTH_URL=http://localhost:3000

# --- Credenciales de la autoridad electoral ---
AUTHORITY_USERNAME=autoridad
AUTHORITY_PASSWORD=reemplazar-con-contrasena-segura

# --- Blockchain: Sepolia Testnet ---
# Usar ALCHEMY_RPC_URL O ALCHEMY_API_KEY (no ambos)
ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/TU_API_KEY_AQUI
# ALCHEMY_API_KEY=TU_API_KEY_AQUI

# Clave privada del wallet de la autoridad (con 0x)
# ADVERTENCIA: esta wallet firma transacciones y necesita ETH en Sepolia
PRIVATE_KEY_AUTORIDAD=0xreemplazar_con_clave_privada_de_32_bytes

# Dirección del contrato desplegado en Sepolia
CONTRACT_ADDRESS=0xreemplazar_con_direccion_del_contrato

# --- Proveedor de identidad (KYC y Liveness) ---
# Opciones: veriff | didit
IDENTITY_VERIFICATION_PROVIDER=veriff

# --- Veriff ---
VERIFF_API_KEY=reemplazar-con-api-key-de-veriff
VERIFF_SECRET_KEY=reemplazar-con-secret-key-de-veriff
# Opcional: por defecto usa https://stationapi.veriff.com
# VERIFF_BASE_URL=https://stationapi.veriff.com
# VERIFF_WEBHOOK_URL=https://tu-dominio.com/api/veriff/webhook
# VERIFF_SANDBOX_MODE=false

# --- Didit ---
# Para usar Didit: IDENTITY_VERIFICATION_PROVIDER=didit
# DIDIT_API_KEY=reemplazar-con-api-key-de-didit
# DIDIT_WORKFLOW_ID=reemplazar-con-workflow-id-de-didit
# DIDIT_WEBHOOK_SECRET=reemplazar-con-webhook-secret-de-didit
# Opcional: por defecto usa https://verification.didit.me
# DIDIT_BASE_URL=https://verification.didit.me
# DIDIT_WEBHOOK_URL=https://tu-dominio.com/api/didit/webhook
# DIDIT_SANDBOX_MODE=false

# --- Claves RSA para Blind Signatures (2048 bits) ---
# Generar con: npm run generate:keys
# Copiar la salida exacta de ese comando aquí, incluyendo los \n escapados.
RSA_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----
RSA_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----\nMIIBIj...\n-----END PUBLIC KEY-----

# --- Candidatos (para el deploy del contrato) ---
# Separados por coma, o como JSON array.
# Ejemplo: CANDIDATOS="Lista A,Lista B,Lista C"
CANDIDATOS=Candidato A,Candidato B,Candidato C

# --- Opciones opcionales ---
# Tiempo de vida del token de voto en minutos (default: 15)
# VOTE_TOKEN_TTL_MINUTES=15
# Ventana de verificación biométrica válida en minutos (default: 15)
# BIOMETRIC_VERIFICATION_WINDOW_MINUTES=15

# --- Etherscan (para verificar el contrato en Etherscan, opcional) ---
# ETHERSCAN_API_KEY=reemplazar-con-api-key-de-etherscan
