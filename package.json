{
  "name": "votar-blockchain",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "dev": "next dev",
    "test:unit": "jest",
    "test:contracts": "hardhat test",
    "deploy:local": "hardhat run contracts/scripts/deploy.ts",
    "deploy:sepolia": "hardhat run contracts/scripts/deploy.ts --network sepolia",
    "generate:keys": "ts-node -e \"const {generateKeyPair} = require('./lib/blindSignature'); generateKeyPair();\"",
    "setup:local": "powershell -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "start": "next start"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.14.10",
    "@types/node-rsa": "^1.1.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.7",
    "jest": "^29.7.0",
    "playwright": "1.49",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@number-flow/react": "^0.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@veriff/incontext-sdk": "^2.5.0",
    "blind-signatures": "^1.0.7",
    "ethers": "^6.16.0",
    "jsbn": "^1.1.0",
    "lucide-react": "^1.17.0",
    "next": "^14.2.35",
    "next-auth": "^4.24.14",
    "node-rsa": "^1.1.1",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
