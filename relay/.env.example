RELAY_PORT=3100
RELAY_RPC_URL=
RELAY_CONTRACT_ADDRESS=
# Clave de la billetera que paga el gas. No es la clave RSA de la autoridad:
# este servicio no puede emitir credenciales, solo retransmitirlas.
RELAY_PRIVATE_KEY=
# Cadena de conexion a la base PROPIA del servicio. Nunca la del padron.
RELAY_DATABASE_URL=
RELAY_TIME_BUCKET_MINUTES=15
RELAY_BATCH_WINDOW_MS=0
RELAY_ALLOWED_ORIGINS=https://votar.example.org
